# APIQuota Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite default for quick start, PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/apiquota?schema=public"

# Security: AES-256-GCM 32-Byte Master Encryption Key (64-character hexadecimal)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=your_64_character_hex_master_key_must_be_32_bytes_long_here_123456

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Background Polling Interval (Cron Expression, e.g. every 15 minutes)
POLL_CRON_SCHEDULE="*/15 * * * *"

# Alerting Threshold Defaults (Percentage remaining, e.g. 20%)
DEFAULT_ALERT_THRESHOLD=20.0

# Telegram Bot Alerting (Optional default fallback)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Alerting Webhook (Optional default fallback)
WHATSAPP_WEBHOOK_URL=
