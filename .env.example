# URL koneksi database SQLite atau PostgreSQL
DATABASE_URL=

# Kunci enkripsi 32-byte (64-char hex) untuk enkripsi AES-256-GCM API key
ENCRYPTION_KEY=

# Port server backend API
PORT=

# Secret key untuk menandatangani dan memverifikasi token autentikasi JWT
JWT_SECRET=

# Token bot Telegram untuk notifikasi kuota via callmebot-notifier
TELEGRAM_BOT_TOKEN=

# Chat ID Telegram tujuan pengiriman notifikasi alert kuota
TELEGRAM_CHAT_ID=
